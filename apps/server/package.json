{
  "name": "@cursor-agent-web/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "env:check": "tsx src/env-check.ts",
    "sdk:smoke": "tsx src/sdk-smoke.ts",
