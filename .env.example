# 从 https://cursor.com/dashboard/integrations 创建（User API Key）
CURSOR_API_KEY=cursor_...

# 网页登录密码（公网部署必改）
APP_PASSWORD=change-me

# 日限额（UTC+8 自然日）
DAILY_RUN_LIMIT=20
DAILY_MESSAGE_LIMIT=100

# Agent 工作目录（编码模式）；Docker/Railway 建议用 DATA_DIR 下路径
AGENT_WORKSPACE=./workspace
CHAT_WORKSPACE=./workspace/chat

# 服务
PORT=3001
MODEL_ID=composer-2.5

# SQLite 路径
DATABASE_PATH=./data/app.db

# 生产（Docker/Railway）示例：
# NODE_ENV=production
# DATA_DIR=/data
# DATABASE_PATH=/data/app.db
# AGENT_WORKSPACE=/data/workspace
# CHAT_WORKSPACE=/data/workspace/chat
# CORS_ORIGIN=https://你的域名.up.railway.app
